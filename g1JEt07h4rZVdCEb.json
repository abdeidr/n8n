      {
        "parameters": {
          "jsCode": "// Recibe el input y limpia espacios\nconst input = $input.first().json.numero;\n\n// Primero eliminar TODOS los espacios del string completo\nconst inputSinEspacios = input.replace(/\\s/g, '');\n\n// Extraer el número después de \"::\"\nconst match = inputSinEspacios.match(/::(\\d+)/);\n\nif (match) {\n  const phoneNumber = match[1];\n  \n  // Formato Evolution API para WhatsApp\n  const whatsappFormat = `34${phoneNumber}@s.whatsapp.net`;\n  \n  return {\n    json: {\n      whatsappId: whatsappFormat\n    }\n  };\n} else {\n  // Si no encuentra el patrón, retorna error o el input original\n  return {\n    json: {\n      error: 'No se encontró el patrón ::número',\n      original: input\n    }\n  };\n}\n"
        },
