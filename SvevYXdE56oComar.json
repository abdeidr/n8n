    {
      "parameters": {
        "jsCode": "const ahora = new Date($now).getTime();\n\nconst debugInfo = $input.all().map(item => {\n  const lead = item.json;\n  \n  const telefono = lead.telefono;\n  const nombre = lead.nombre;\n  const fechaCitaStr = lead[\"fecha de la cita\"] || null;\n  const agendado = lead.agendado;\n  \n  let horasParaCita = 'N/A';\n  \n  if (fechaCitaStr && fechaCitaStr !== '') {\n    // Convertir la fecha UTC a hora local de Madrid\n    const fechaCita = new Date(fechaCitaStr.replace('+0000', '+0100')).getTime();\n    \n    if (!isNaN(fechaCita)) {\n      horasParaCita = (fechaCita - ahora) / (1000 * 60 * 60);\n    }\n  }\n  \n  return {\n    row_number: lead.row_number,\n    telefono: telefono,\n    nombre: nombre,\n    fechaCita: fechaCitaStr,\n    agendado: agendado,\n    horasParaCita: typeof horasParaCita === 'number' ? Math.round(horasParaCita * 100) / 100 : horasParaCita\n  };\n});\n\nreturn debugInfo;"
      },
