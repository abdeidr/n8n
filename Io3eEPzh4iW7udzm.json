      {
        "parameters": {
          "jsCode": "let numero = $('Facebook Lead Ads Trigger').first().json.data.phone_number || $input.first().json.phone_number || '';\nlet fullName = $('Facebook Lead Ads Trigger').first().json.data.full_name || $input.first().json.full_name || '';\n\nif (!numero) {\n  return { json: { error: 'No se encontró el número de teléfono en el input' }};\n}\n\n// Extraer solo el primer nombre con la primera letra en mayúscula\nconst rawFirst = fullName.trim().split(/\\s+/)[0] || '';\nconst firstName = rawFirst.charAt(0).toUpperCase() + rawFirst.slice(1).toLowerCase();\n\nnumero = numero.replace(/\\D/g, '');\n// México\nif (numero.startsWith('52')) {\n  if (!numero.startsWith('521')) {\n    numero = '521' + numero.slice(2);\n  }\n} else if (numero.length === 10) {\n  numero = '521' + numero;\n}\n// España\nif (numero.length === 9) {\n  numero = '34' + numero;\n}\n// Evolution API: formato tipo \"521xxxxxxxxxx@s.whatsapp.net\"\nnumero = numero + '@s.whatsapp.net';\n\nreturn {\n  json: {\n    number: numero,\n    first_name: firstName\n  }\n};"
        },
