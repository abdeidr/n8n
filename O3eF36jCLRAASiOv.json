        "name": "Edit Fields"
      },
      {
        "parameters": {
          "jsCode": "// n8n Code Node - AVISO DUEÑO CancionTuya.es (NUEVO LEAD)\nconst leads = $input.all();\nconst ownerPhone = '+34604863683'; // Tu WhatsApp\n\nreturn leads.map(lead => {\n  const data = lead.json;\n  \n  // Personalización\n  const recipient = data.recipientName || 'ser querido';\n  const relationship = data.relationship === 'Abuelo/Abuela' ? 'abuelo/a' : data.relationship.toLowerCase();\n  const occasion = data.occasion;\n  const style = data.musicStyle;\n  const voice = data.voiceType === 'Voz femenina' ? 'femenina' : 'masculina';\n  \n  // Extras y total\n  let extrasText = '';\n  let total = 19.99;\n  if (data.extras.wav) { \n    extrasText += 'WAV '; \n    total += 2.99; \n  }\n  if (data.extras['2versions']) { \n    extrasText += '2VOZ '; \n    total += 9.99; \n  }\n  if (data.extras['2songs']) { \n    extrasText += '2CANCIONES'; \n    total += 9.99; \n  }\n  \n  const mensaje = `🚨 *¡NUEVO PEDIDO CANCIONTUYA!*\n\n👤 *Cliente:* ${data.customerName}\n📧 *Email:* ${data.gmail}\n\n🎁 *DETALLES PEDIDO:*\n❤️ Para: ${recipient}\n👪 Relación: ${relationship}\n🎉 Ocasión: ${occasion}\n🎸 Estilo: ${style}\n🎤 Voz: ${voice}\n💭 Historia: \"${data.memories}\"\n🔑 Keywords: ${data['palabras clave']}\n\n🛒 *Extras:* ${extrasText || 'Ninguno'}\n💰 *TOTAL:* *${total.toFixed(2)}€*\n\n⏰ *ACTÚA YA* - Cliente esperando confirmación\n🔗 canciontuya.es`;\n\n  return {\n    json: {\n      to: `whatsapp:${ownerPhone}`,\n      message: mensaje,\n      customerName: data.customerName,\n      total: total.toFixed(2),\n      leadId: `CT-${Date.now()}`,\n      status: 'new_lead'\n    }\n  };\n});\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          416,
          0
        ],
