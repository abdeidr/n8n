      "parameters": {
        "jsCode": "// Obtener todos los items de entrada\nconst items = $input.all();\n\n// Verificar que tenemos exactamente 2 items\nif (items.length !== 2) {\n  throw new Error(`Se esperan 2 items, pero hay ${items.length}`);\n}\n\nconsole.log('Item 0 binary fields:', Object.keys(items[0].binary || {}));\nconsole.log('Item 1 binary fields:', Object.keys(items[1].binary || {}));\n\n// Los items del Merge ya tienen data1 y data2\n// Item 0 tiene data2 (coche)\n// Item 1 tiene data1 (fondo)\n\n// Verificar qué campos binarios tiene cada item\nconst item0HasData2 = items[0].binary && items[0].binary.data;\nconst item1HasData1 = items[1].binary && items[1].binary.data1;\n\nif (!item0HasData2) {\n  throw new Error('Item 0 no tiene campo binario \"data2\"');\n}\n\nif (!item1HasData1) {\n  throw new Error('Item 1 no tiene campo binario \"data1\"');\n}\n\n// Combinar ambos binarios en UN SOLO item\nreturn [{\n  json: {\n    message: 'Imágenes combinadas correctamente'\n  },\n  binary: {\n    data1: items[1].binary.data1,  // Fondo concesionario\n    data2: items[0].binary.data   // Coche\n  }\n}];\n"
